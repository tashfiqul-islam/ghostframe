{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The screenshot script, run by Bun: Bun's ambient types, and the DOM for the code it runs in the page.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
