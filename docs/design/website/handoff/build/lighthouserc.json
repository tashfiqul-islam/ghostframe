{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/", "/releases/", "/404.html"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1800
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ],
        "resource-summary:font:size": [
          "warn",
          {
            "maxNumericValue": 90000
          }
        ],
        "resource-summary:image:size": [
          "warn",
          {
            "maxNumericValue": 180000
          }
        ]
      }
    }
  }
}
