{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The live-check harness, run by Bun: the ambient types are Bun's (Node's APIs among them, for node-pty and the
  // headless xterm). It imports the plugin's palette, which needs nothing else.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "out"]
}
