{
  "name": "ghostframe-dev-tools",
  "private": true,
  "description": "Development tools for the ghostframe mod. Kept out of the plugin root: a package.json with a lockfile there makes Claude Code install dependencies on every user's machine.",
  "type": "module",
  "scripts": {
    "typecheck": "cd .. && tsc -p .",
    "lint": "cd .. && oxlint -c tools/oxlint.config.ts --type-aware --deny-warnings",
    "lint:ci": "cd .. && oxlint -c tools/oxlint.config.ts --deny-warnings --format github",
    "fmt": "cd .. && oxfmt",
    "fmt:check": "cd .. && oxfmt --check",
    "commitlint": "commitlint --config commitlint.config.ts",
    "validate": "cd .. && claude plugin validate .",
    "test": "cd .. && claude plugin test .",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run validate && bun run test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "eslint-plugin-jsdoc": "65.4.7",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  }
}
