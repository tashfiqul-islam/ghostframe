---
import type { Wording } from './words'

interface Props {
  of: Wording
}
const { of } = Astro.props
---

{
  typeof of === 'string' ? (
    of
  ) : (
    <>
      <span class="wide">{of.text}</span>
      <span class="narrow">{of.short}</span>
    </>
  )
}

<style>
  .narrow {
    display: none;
  }
  /* --bp-narrow in tokens.css: the 390 layout. */
  @media (max-width: 1023px) {
    .wide {
      display: none;
    }
    .narrow {
      display: inline;
    }
  }
</style>
