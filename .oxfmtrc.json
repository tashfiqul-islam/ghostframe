{
  "$schema": "./tools/node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".claude-plugin/types/**",
    "docs/design/brand/**",
    "docs/design/website/*.dc.html",
    "docs/design/website/canvas.json",
    "docs/assets/captures/**",
    "tools/node_modules/**",
    "tools/bun.lock",
    "docs/design/history/cockpit-v7.md",
    "docs/design/statusline-preview.ts",
    "tools/mockgen/tpl/**",
    "tests/support/screens.ts",
    "CHANGELOG.md",
    ".release-please-manifest.json"
  ],
  "overrides": [
    {
      "files": [".claude-plugin/plugin.json"],
      "options": { "printWidth": 1 }
    }
  ]
}
